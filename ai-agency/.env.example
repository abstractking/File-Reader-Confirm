# ══════════════════════════════════════════
#  AI AGENCY — Environment Variables
#  Set these in CodeSandbox → Settings → Env Vars
#  NEVER commit real values to git
# ══════════════════════════════════════════

# ── Neon PostgreSQL ───────────────────────
# Get from: neon.tech → your project → Connection string
# Format: postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# ── Anthropic / Claude ────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Slack ─────────────────────────────────
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-...

# Signing Secret
SLACK_SIGNING_SECRET=abc123...

# Channel ID for #approvals channel
SLACK_CHANNEL_ID=C0XXXXXXXXX

# ── Server ────────────────────────────────
PORT=8080
NODE_ENV=development
