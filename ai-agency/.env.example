# ══════════════════════════════════════════
#  AI AGENCY — Environment Variables
#  Add these in Replit → Secrets tab
#  NEVER commit this file
# ══════════════════════════════════════════

# ── Replit PostgreSQL ─────────────────────
# Replit injects this automatically when you
# enable PostgreSQL in your Repl — copy it from
# Tools → Database → Connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Anthropic / Claude ────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Slack ─────────────────────────────────
# Bot User OAuth Token (xoxb-...)
# From: api.slack.com → Your App → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-...

# Signing Secret
# From: api.slack.com → Your App → Basic Information
SLACK_SIGNING_SECRET=abc123...

# Channel ID for #approvals
# Right-click channel in Slack → View channel details → copy ID at bottom
SLACK_CHANNEL_ID=C0XXXXXXXXX

# ── Server ────────────────────────────────
PORT=3000
NODE_ENV=production
